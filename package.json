{
  "name": "racecar-cli",
  "version": "0.1.0",
  "private": false,
  "packageManager": "yarn@4.17.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --build && yarn workspace @racecar/shim bundle",
    "clean": "tsc --build --clean && rimraf 'packages/*/dist'",
    "typecheck": "tsc --build",
    "lint": "eslint .",
    "fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
