{
  "name": "@racecar/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "racecar": "./dist/main.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./shim-connect": {
      "types": "./dist/shim-connect.d.ts",
      "default": "./dist/shim-connect.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "start": "node ./dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@racecar/core": "workspace:^",
    "@racecar/shim": "workspace:^",
    "yaml": "^2.0.0"
  }
}
