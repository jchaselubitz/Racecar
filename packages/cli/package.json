{
  "name": "racecar-cli",
  "version": "0.1.0",
  "description": "Agent-agnostic, launcher-agnostic control-plane CLI for cloud coding sandboxes.",
  "license": "MIT",
  "author": "Jake Chase-Lubitz",
  "homepage": "https://github.com/jchaselubitz/Racecar#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jchaselubitz/Racecar.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/jchaselubitz/Racecar/issues"
  },
  "keywords": [
    "cli",
    "sandbox",
    "coding-agent",
    "daytona",
    "acp"
  ],
  "type": "module",
  "bin": {
    "racecar": "dist/racecar.js"
  },
  "exports": {
    "./shim-connect": {
      "types": "./dist/shim-connect.d.ts",
      "default": "./dist/shim-connect.js"
    }
  },
  "files": [
    "dist/racecar.js",
    "dist/racecar-shim.cjs"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc --build && node scripts/bundle.mjs",
    "bundle": "node scripts/bundle.mjs",
    "start": "node ./dist/racecar.js",
    "test": "vitest run",
    "prepublishOnly": "yarn workspace @racecar/shim build && yarn workspace racecar-cli build"
  },
  "dependencies": {
    "@daytona/sdk": "^0.196.0",
    "ws": "^8.18.0",
    "yaml": "^2.0.0"
  },
  "devDependencies": {
    "@racecar/core": "workspace:^",
    "@racecar/shim": "workspace:^",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.21.5"
  }
}
